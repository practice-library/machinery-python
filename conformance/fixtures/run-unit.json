    },
    {
      "name": "a recorded response with neither status nor error is invalid_argument",
      "request": {
        "network": {
          "hosts": [],
          "replay": {
            "start": "2026-10-31T12:00:00Z",
            "exchanges": {
              "https://docs.example.com/robots.txt": [
                {
                  "body": "x"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "code": "invalid_argument",
        "envelope": {
          "ok": false,
          "warnings": [
            {
              "$startsWith": "network.replay.exchanges"
            }
          ]
        }
      }
    },
    {
      "name": "a recorded header that is not a string is invalid_argument",
      "request": {
        "network": {
          "hosts": [],
          "replay": {
            "start": "2026-10-31T12:00:00Z",
            "exchanges": {
              "https://docs.example.com/robots.txt": [
                {
                  "status": 200,
