      },
      "expect": {
        "code": "invalid_argument",
        "envelope": {
          "ok": false,
          "warnings": [
            {
              "$startsWith": "network.replay.exchanges"
            }
          ]
        }
      }
    },
    {
      "name": "an empty recorded error is invalid_argument",
      "request": {
        "network": {
          "hosts": [],
          "replay": {
            "start": "2026-10-31T12:00:00Z",
            "exchanges": {
              "https://docs.example.com/robots.txt": [
                {
                  "error": ""
                }
              ]
            }
          }
        }
      },
      "expect": {
        "code": "invalid_argument",
        "envelope": {
          "ok": false,
