          }
        }
      },
      "expect": {
        "code": "invalid_argument",
        "envelope": {
          "ok": false,
          "warnings": [
            {
              "$startsWith": "network.replay.exchanges"
            }
          ]
        }
      }
    },
    {
      "name": "a recorded status written as a string is invalid_argument",
      "request": {
        "network": {
          "hosts": [],
          "replay": {
            "start": "2026-10-31T12:00:00Z",
            "exchanges": {
              "https://docs.example.com/robots.txt": [
                {
                  "status": "200"
                }
              ]
