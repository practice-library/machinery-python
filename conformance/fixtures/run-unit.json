          ]
        }
      }
    },
    {
      "name": "a recorded error with headers is invalid_argument",
      "request": {
        "network": {
          "hosts": [],
          "replay": {
            "start": "2026-10-31T12:00:00Z",
            "exchanges": {
              "https://docs.example.com/robots.txt": [
                {
                  "error": "reset",
                  "headers": {}
                }
              ]
